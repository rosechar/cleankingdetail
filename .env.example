# --- Resend (booking & contact form emails) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address. The domain must be verified in Resend.
# Format: "Display Name <address@your-verified-domain.com>"
RESEND_FROM=Clean King Detailing <bookings@cleankingdetail.com>

# Where owner/staff appointment & contact alerts are sent.
# Comma-separate multiple recipients.
OWNER_ALERT_EMAILS=owner@example.com,staff@example.com

# Segment that collects promo opt-ins from the booking & contact forms.
# Find the ID at https://resend.com/segments. Optional — opt-ins are
# simply not stored as contacts when unset.
RESEND_SEGMENT_ID=
